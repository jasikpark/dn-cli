# Copy to .env (gitignored), then run:  op run --env-file=.env -- dn hosts list
# (or `just run hosts list`).
#
# The value is a 1Password SECRET REFERENCE (op://vault/item/field), NOT the
# secret itself — `op run` resolves it at invocation time. Find the reference in
# the 1Password app: right-click the field -> "Copy Secret Reference".
DEFINED_API_KEY=op://<vault>/<item>/credential

# Optional: override the API base URL (defaults to https://api.defined.net)
# DEFINED_API_URL=https://api.defined.net
